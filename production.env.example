# Host and infrastructure settings. Copy to production.env on the server.
#
# deploy.sh sources this file with bash, so quote any value containing spaces.
# Application settings go in iobio.env instead.

# Public hostname. Must already resolve to this instance before the first
# deploy, or Let's Encrypt cannot issue a certificate. IOBIO_BACKEND_ORIGIN is
# derived from this value.
DOMAIN=gene.example.org

# Contact address for Let's Encrypt expiry/problem notices.
ACME_EMAIL=

# Host path of the gru data directory (~128 GB). Must be a mount point;
# deploy.sh refuses to sync into an unmounted directory.
DATA_DIR=/mnt/gru_data

# Source deploy.sh syncs DATA_DIR from, with rclone, before every deploy. This
# path is versionless and tracks the current data release, so data upgrades
# arrive with a deploy — check the release notes before pinning an older IMAGE.
DATA_URL=https://files.iobio.io/gru_data/data/gru_data_2/

# Bump this to deploy a new backend version.
IMAGE=docker.io/iobio/iobio-gru-backend:2.0.0
